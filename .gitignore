# gitignore considerando desenvolvimento com: Next.js, NestJS, Prisma (SQLite)


# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# nestjs
*/dist
*/build
*/tmp

# next.js
*/.next/
*/out/

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# dotenv environment variable files
.env
.env.development
.env.test
.env.production
.env*.local

# temp directory
.temp
.tmp

# dependencies
*/node_modules
node_modules
*/.pnp
.pnp.js

# testing
*/coverage

# production
*/build

# misc
.DS_Store
*.pem

# vercel
.vercel

# Prisma
*/generated/prisma
*/prisma/generated

# SQLite
*.db
*.db-journal

# Projeto
*/.agents/
*/.claude/
*/.windsurf/
